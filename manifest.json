{\n  "manifest_version": 3,\n  "name": "LangBridge",\n  "version": "1.0.0",\n  "description": "Real-time emotional video translation — watch anime in your language with the emotion intact.",\n  "permissions": [\n    "tabCapture",\n    "activeTab",\n    "storage",\n    "scripting"\n  ],\n  "host_permissions": [\n    "*://www.youtube.com/*"\n  ],\n  "background": {\n    "service_worker": "background.js"\n  },\n  "content_scripts": [\n    {\n      "matches": ["*://www.youtube.com/*"],\n      "js": ["content.js"],\n      "run_at": "document_idle"\n    }\n  ],\n  "action": {\n    "default_popup": "popup/popup.html",\n    "default_title": "LangBridge"\n  },\n  "web_accessible_resources": [\n    {\n      "resources": ["utils/*"],\n      "matches": ["*://www.youtube.com/*"]\n    }\n  ]\n}